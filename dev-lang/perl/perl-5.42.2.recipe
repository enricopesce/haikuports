#        ../cpan/IO-Socket-IP/t/11sockopts.t
#        ../cpan/IO-Socket-IP/t/18fdopen.t
#        ../cpan/Time-Piece/t/02core.t
#        ../dist/IO/t/cachepropagate-unix.t
#        ../dist/Time-HiRes/t/utime.t
#        ../ext/I18N-Langinfo/t/Langinfo.t
#        ../ext/POSIX/t/mb.t
#        ../ext/POSIX/t/time.t
