SUMMARY="HTTP/2 C Library"
DESCRIPTION="nghttp2 is an implementation of HTTP/2 and its header compression \
algorithm HPACK in C."
HOMEPAGE="https://nghttp2.org/"
COPYRIGHT="2012-2024 Tatsuhiro Tsujikawa & nghttp2 contributors"
LICENSE="MIT"
REVISION="1"
SOURCE_URI="https://github.com/nghttp2/nghttp2/releases/download/v$portVersion/nghttp2-$portVersion.tar.xz"
CHECKSUM_SHA256="4879c75dd32a74421b9857924449460b8341796c0613ba114ab2188e4622354b"

ARCHITECTURES="all"
SECONDARY_ARCHITECTURES="x86"

libVersion="14.28.2"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"

PROVIDES="
	nghttp2$secondaryArchSuffix = $portVersion
	lib:libnghttp2$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

PROVIDES_devel="
	nghttp2${secondaryArchSuffix}_devel = $portVersion
	devel:libnghttp2$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	nghttp2$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:aclocal
	cmd:autoconf
	cmd:automake
	cmd:gcc$secondaryArchSuffix
	cmd:make
	cmd:readelf
	cmd:pkg_config$secondaryArchSuffix
	"

if [ "$targetArchitecture" != "arm64" ]; then
	defineDebugInfoPackage nghttp2$secondaryArchSuffix \
		"$libDir"/libnghttp2.so.$libVersion
fi

BUILD()
{
	runConfigure ./configure \
		--enable-lib-only \

	make $jobArgs
}

INSTALL()
{
	make install
	if [ "$targetArchitecture" = "arm64" ]; then
		arm64RuntimeLibDir="$installDestDir$prefix/$relativeLibDir"
		mkdir -p "$arm64RuntimeLibDir"
		for sharedLibrary in "$sourceDir/lib/.libs"/libnghttp2.so*; do
			[ -e "$sharedLibrary" ] || [ -L "$sharedLibrary" ] || continue
			cp -af "$sharedLibrary" "$arm64RuntimeLibDir/"
		done
		[ -e "$arm64RuntimeLibDir/libnghttp2.so" ] || { echo "ARM64 libnghttp2 staging failed" >&2; exit 1; }
		arm64HeaderDir="$installDestDir$prefix/$relativeIncludeDir/nghttp2"
		mkdir -p "$arm64HeaderDir"
		cp -af "$sourceDir/lib/includes/nghttp2/." "$arm64HeaderDir/"
	fi


	rm -f "$libDir"/libnghttp2.la "$libDir"/libnghttp2.a

	rm -rf "$manDir"/man1

	prepareInstalledDevelLib libnghttp2
	fixPkgconfig

	if [ "$targetArchitecture" = "arm64" ]; then
		rm -rf "$(getPackagePrefix devel)/$relativeDevelopDir"
	fi

	packageEntries devel \
		"$relativeDevelopDir"

	rmdir "$manDir"
}

TEST()
{
	make check
}
