SUMMARY="A WPA Supplicant with support for WPA and WPA2"
DESCRIPTION="
wpa_supplicant is a WPA Supplicant for Linux, BSD, macOS, Windows, and Haiku \
with support for WPA and WPA2 (IEEE 802.11i / RSN). It is suitable for both \
desktop/laptop computers and embedded systems. Supplicant is the IEEE \
802.1X/WPA component that is used in the client stations. It implements key \
negotiation with a WPA Authenticator and it controls the roaming and IEEE \
802.11 authentication/association of the wlan driver."
HOMEPAGE="https://w1.fi/wpa_supplicant/"
COPYRIGHT="2003-2022 Jouni Malinen"
LICENSE="BSD (2-clause)
	GNU GPL v2"
REVISION="1"
srcGitRev="bdf3144ad606b226aca6f8fae103e671e4655138"
SOURCE_URI="https://github.com/haiku/wpa_supplicant/archive/$srcGitRev.tar.gz"
CHECKSUM_SHA256="e7e36b4ed5d6ff0e6a233b427b312c6984ab01d79e219d0d4b9c9e2ccf86f8ab"
SOURCE_DIR="wpa_supplicant-$srcGitRev"
PATCHES="wpa_supplicant-2.11-security.patchset
	wpa_supplicant-2.11-gcc2.patch
	wpa_supplicant-2.11-haiku-arm64.patch"

ARCHITECTURES="all"

PROVIDES="
	wpa_supplicant = $portVersion compat >= 2
	cmd:wpa_supplicant = $portVersion compat >= 2
	"
REQUIRES="
	haiku
	lib:libcrypto
	"

BUILD_REQUIRES="
	devel:libssl >= 3
	"
BUILD_PREREQUIRES="
	haiku_devel
	cmd:gcc
	cmd:ld
	cmd:make
	"

BUILD()
{
	cd wpa_supplicant
	if [ "$targetArchitecture" = arm64 ]; then
		sed -i "s/#if defined(__linux__) || defined(__GLIBC__)/#if (defined(__linux__) || defined(__GLIBC__)) \&\& !defined(__HAIKU__)/" ../src/utils/common.h
		sed -i 's/mimeset -F wpa_supplicant/true # skipped for cross-build on Linux host/' Makefile
		local haikuHeaderFlags="-DETHER_ADDR_LEN=6 -DMD5_MAC_LEN=16 -DIFM_MMASK=0 -DIFM_IEEE80211_IBSS=0 -DIFM_IEEE80211_ADHOC=0 -DIFM_FLAG0=0 -DIFM_IEEE80211_11A=0 -DIFM_IEEE80211_11B=0 -DIFM_IEEE80211_11G=0 -DIFM_IEEE80211_11NA=0 -DIFM_IEEE80211_11NG=0 -DIFM_IEEE80211_HOSTAP=0 -DIFM_IEEE80211_MONITOR=0 -include $crossSysrootDir/boot/system/develop/headers/bsd/sys/ioccom.h -I$crossSysrootDir/boot/system/develop/headers/os -I$crossSysrootDir/boot/system/develop/headers/posix -I$crossSysrootDir/boot/system/develop/headers/private -I$crossSysrootDir/boot/system/develop/headers/private/net -I$crossSysrootDir/boot/system/develop/headers/private/libs/compat/freebsd_wlan -I$crossSysrootDir/boot/system/develop/headers/compatibility/bsd"
		if [ -n "${HAIKU_SOURCE_DIR:-}" ]; then
			haikuHeaderFlags+=" -I$HAIKU_SOURCE_DIR/src/libs/compat/freebsd_wlan"
		fi
		for headerDir in "$crossSysrootDir/boot/system/develop/headers/os/"*; do
			[ -d "$headerDir" ] && haikuHeaderFlags+=" -I$headerDir"
		done
		make CC="$targetMachineTriple-gcc --sysroot=$crossSysrootDir" CXX="$targetMachineTriple-g++ --sysroot=$crossSysrootDir" LDO="$targetMachineTriple-g++ --sysroot=$crossSysrootDir" EXTRA_CFLAGS="$haikuHeaderFlags" wpa_supplicant
	else
		make wpa_supplicant
	fi
}

INSTALL()
{
	cd wpa_supplicant
	mkdir -p $installDestDir$binDir
	cp -v wpa_supplicant $installDestDir$binDir

appSig=x-vnd.malinen-wpa_supplicant
	localeFolder=$installDestDir$dataDir/locale/catalogs
	mkdir -p $localeFolder/$appSig

	for file in wpa_gui-haiku/locales/*.catkeys; do
		catLang=$(basename $file .catkeys)
		echo "Linking $catLang.catalog..."
		linkcatkeys -o $localeFolder/$appSig/$catLang.catalog \
			-s "application/$appSig" -l $catLang "$file"
	done
}
