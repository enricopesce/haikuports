SUMMARY="A programmer's editor"
DESCRIPTION="Pe is a native programmer's editor for Haiku. It features syntax \
highlighting and a structural view for several programming language, as well \
as basic support for Makefile and Jamfile project management."
HOMEPAGE="https://github.com/HaikuArchives/Pe"
COPYRIGHT="
	1996-2002 Maarteen Hekkelman
	2003-2025 Team Pe
	"
LICENSE="
	BSD (4-clause)
	MIT
	"
REVISION="1"
SOURCE_URI="https://github.com/HaikuArchives/Pe/archive/v$portVersion.tar.gz"
CHECKSUM_SHA256="adc168eaf753f9c70a48b50171f90b6c145e7033c83e2f42936209bc1e99d61b"
SOURCE_DIR="Pe-$portVersion"

ARCHITECTURES="all"

USER_SETTINGS_FILES="
	settings/pe directory
	"

PROVIDES="
	pe = $portVersion
	app:Pe = $portVersion compat >= 2
	cmd:lpe = $portVersion compat >= 2
	"
REQUIRES="
	haiku
	lib:libpcre
	lib:libpcreposix
	"

BUILD_REQUIRES="
	haiku_devel
	devel:libpcre
	devel:libpcreposix
	"
BUILD_PREREQUIRES="
	cmd:bison
	cmd:flex
	cmd:gcc
	cmd:jam
	cmd:ld
	"

BUILD()
{
	if [ "$targetArchitecture" = arm64 ]; then
		sed -i "/You need to have pcre installed/d" build/BuildSettings
		sed -i "s/LINKLIBS += -lnet ;/LINKLIBS += -lnetwork ;/" build/BuildSettings
		sed -i "/MimeSet/d" build/OverriddenJamRules
		local haikuIncludePath="$crossSysrootDir/boot/system/develop/headers/os:$crossSysrootDir/boot/system/develop/headers/os/support:$crossSysrootDir/boot/system/develop/headers/private/tracker"
		C_INCLUDE_PATH="$haikuIncludePath:$C_INCLUDE_PATH" CPLUS_INCLUDE_PATH="$haikuIncludePath:$CPLUS_INCLUDE_PATH" jam -q -sOSPLAT=X86 -sDISTRO_DIR=distro -sOS=HAIKU -sIS_GCC_4_PLATFORM=1 -sCC="$targetMachineTriple-gcc --sysroot=$crossSysrootDir" -sC++="$targetMachineTriple-g++ --sysroot=$crossSysrootDir" -sLINK="$targetMachineTriple-g++ --sysroot=$crossSysrootDir"
	else
		jam -q -sOSPLAT=X86 -sDISTRO_DIR=distro
	fi
}

INSTALL()
{
	peDir=$appsDir/Pe

	if [ "$targetArchitecture" = arm64 ]; then
		mkdir -p "$installDestDir$appsDir" "$installDestDir$binDir" "$installDestDir$dataDir/deskbar/menu/Applications"
		cp -a distro "$installDestDir$peDir"
		cp -a doc "$installDestDir$peDir/Documentation"
		ln -sfn "$peDir/lpe" "$installDestDir$binDir/lpe"
		symlinkRelative -s "$installDestDir$peDir/Pe" "$installDestDir$dataDir/deskbar/menu/Applications/Pe"
	else
		mkdir -p $appsDir
		cp -a distro $peDir
		cp -a doc $peDir/Documentation
		mkdir $binDir
		ln -sfn $peDir/lpe $binDir
		addAppDeskbarSymlink $peDir/Pe
	fi
}
