SUMMARY="A perl module for parsing XML documents"
DESCRIPTION="XML-Parser - A perl module for parsing XML documents."
HOMEPAGE="https://metacpan.org/pod/XML::Parser"
COPYRIGHT="1998-2000 Larry Wall and Clark Cooper"
LICENSE="Artistic"
REVISION="4"
SOURCE_URI="https://cpan.metacpan.org/authors/id/T/TO/TODDR/XML-Parser-$portVersion.tar.gz"
CHECKSUM_SHA256="ad4aae643ec784f489b956abe952432871a622d4e2b5c619e8855accbfc4d1d8"
SOURCE_DIR="XML-Parser-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	xml_parser$secondaryArchSuffix = $portVersion
	"
if [ -n "$secondaryArchSuffix" ]; then
	PROVIDES+="
		xml_parser = $portVersion
		"
fi
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libexpat$secondaryArchSuffix
	vendor_perl
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libexpat$secondaryArchSuffix
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:make
	cmd:perl
	"

# TODO: Remove hardcoded paths. The following shows how to get the the file path:
#find /boot/common/lib/perl5 -type f -name unixish.h | grep -FzZ BePC-haiku/CORE/unixish.h

BUILD()
{
	if [ "$targetArchitecture" = arm64 ]; then
		# Makefile.PL's Devel::CheckLib uses the build Perl's native compiler,
		# so its link probe cannot validate Haiku ARM64 libraries. HaikuPorter
		# already resolved libexpat's target development package for this build.
		perl -0777 -i -pe 's/unless \(\s*check_lib\(.*?\n\) \{/if (0) {/s or die "could not disable host-only Expat probe\n"' Makefile.PL
		perl Makefile.PL PREFIX=$prefix \
			CC=$targetMachineTriple-gcc LD=$targetMachineTriple-gcc \
			EXPATLIBPATH=$crossSysrootDir/boot/system/develop/lib \
			EXPATINCPATH=$crossSysrootDir/boot/system/develop/headers
		haikuPortsBuildDir=$(cd "$crossSysrootDir/../../../../../.." && pwd)
		perlCoreHeader=$(find "$crossSysrootDir/boot/system/lib/perl5" -path '*/CORE/perl.h' -print -quit)
		perlSourceHeader=$(find "$haikuPortsBuildDir/dev-lang/perl" -path '*/sources/perl-*/haiku/haikuish.h' -print -quit)
		if [ -z "$perlCoreHeader" ] || [ -z "$perlSourceHeader" ]; then
			echo "Could not locate target Perl ARM64 development headers" >&2
			exit 1
		fi
		perlCoreDir=${perlCoreHeader%/perl.h}
		perlSourceDir=${perlSourceHeader%/haiku/haikuish.h}
		sed -i \
			-e "s|^PERL_INC = .*|PERL_INC = $perlCoreDir|" \
			-e "s|^INC = .*|INC = -I$perlSourceDir -I$crossSysrootDir/boot/system/develop/headers|" \
			-e "s|^LDDLFLAGS = .*|LDDLFLAGS = -shared|" \
			Expat/Makefile
	else
		perl Makefile.PL PREFIX=$prefix
	fi
	if [ -f Expat/Makefile ]; then
		sed -i 's/-fstack-protector//g' Expat/Makefile
	fi
	make
}

INSTALL()
{
	make pure_install
}

TEST()
{
	make test
}
