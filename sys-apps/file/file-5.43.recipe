SUMMARY="Identify a file's format by scanning binary data for patterns"
DESCRIPTION="This is Release 5.x of Ian Darwin's (copyright but distributable) \
file(1) command, an implementation of the Unix File(1) command. It knows the \
'magic number' of several thousands of file types. This version is the \
standard 'file' command for Linux, *BSD, and other systems. (See \
'patchlevel.h' for the exact release number)."
HOMEPAGE="https://www.darwinsys.com/file/"
COPYRIGHT="1986-1999 Ian F. Darwin
	1994-2018 Christos Zoulas"
LICENSE="BSD (2-clause)"
REVISION="2"
SOURCE_URI="http://ftp.astron.com/pub/file/file-$portVersion.tar.gz"
CHECKSUM_SHA256="8c8015e91ae0e8d0321d94c78239892ef9dbc70c4ade0008c0e95894abfb1991"
PATCHES="file-$portVersion.patchset"

ARCHITECTURES="all"
SECONDARY_ARCHITECTURES="x86_gcc2 x86"

libVersion="1.0.0"
libVersionCompat="$libVersion compat >= ${libVersion%%.*}"
portVersionCompat="$portVersion compat >= 5"

PROVIDES="
	file$secondaryArchSuffix = $portVersion
	cmd:file$secondaryArchSuffix = $portVersionCompat
	lib:libmagic$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES="
	haiku$secondaryArchSuffix
	file_data == $portVersion
	lib:libz$secondaryArchSuffix
	"

if [ -z "$secondaryArchSuffix" ]; then
	SUMMARY_data="Magic file for the file(1) command"
	ARCHITECTURES_data="any"
	PROVIDES_data="
		file_data = $portVersion
		"
	REQUIRES_data=""
fi

PROVIDES_devel="
	file${secondaryArchSuffix}_devel = $portVersion
	devel:libmagic$secondaryArchSuffix = $libVersionCompat
	"
REQUIRES_devel="
	file$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	devel:libz$secondaryArchSuffix
	"
if [ -n "$secondaryArchSuffix" ]; then
	BUILD_REQUIRES="$BUILD_REQUIRES
		file_data == $portVersion
		"
fi

BUILD_PREREQUIRES="
	cmd:aclocal
	cmd:automake
	cmd:autoreconf
	cmd:gcc$secondaryArchSuffix
	cmd:libtoolize$secondaryArchSuffix
	cmd:make
	cmd:sed
	"

if [ "$targetArchitecture" != arm64 ]; then
	defineDebugInfoPackage file$secondaryArchSuffix \
		"$binDir"/file \
		"$libDir"/libmagic.so.$libVersion
fi

BUILD()
{
	autoreconf
	if [ "$targetArchitecture" = arm64 ]; then
		local hostFileDir="/work/host-tools/file-$portVersion"
		mkdir -p /work/host-tools/bin
		if ! /work/host-tools/bin/file --version 2>/dev/null | grep -q "$portVersion"; then
			rm -rf "$hostFileDir"
			cp -a "$sourceDir" "$hostFileDir"
			(
				cd "$hostFileDir"
				/usr/bin/make distclean >/dev/null 2>&1 || true
				unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH LIBRARY_PATH
				unset CFLAGS CPPFLAGS LDFLAGS
				CC=/usr/bin/gcc CXX=/usr/bin/g++ ./configure --disable-shared
				/usr/bin/make $jobArgs
			)
			cp -f "$hostFileDir/src/file" /work/host-tools/bin/file
		fi
		export PATH="/work/host-tools/bin:$PATH"
	fi
	runConfigure ./configure
	make
}

INSTALL()
{
	make install

	if [ "$targetArchitecture" = arm64 ]; then
		mkdir -p "$installDestDir$binDir" "$installDestDir$libDir"
		cp -f "$sourceDir/src/file" "$installDestDir$binDir/"
		cp -af "$sourceDir"/src/.libs/libmagic.so* "$installDestDir$libDir/"
	fi

	# remove libtool file
	rm -f $libDir/libmagic.la

	prepareInstalledDevelLib libmagic
	fixPkgconfig

	if [ -z "$secondaryArchSuffix" ]; then
		if [ "$targetArchitecture" = arm64 ]; then
			mkdir -p "$installDestDir$prefix/$relativeDataDir/misc"
			cp -f "$sourceDir/magic/magic.mgc" "$installDestDir$prefix/$relativeDataDir/misc/"
			mkdir -p "$installDestDir$prefix/$relativeManDir/man1" "$installDestDir$prefix/$relativeManDir/man3" "$installDestDir$prefix/$relativeManDir/man4"
			cp -f "$sourceDir/doc/file.1" "$installDestDir$prefix/$relativeManDir/man1/"
			cp -f "$sourceDir/doc/libmagic.3" "$installDestDir$prefix/$relativeManDir/man3/"
			cp -f "$sourceDir/doc/magic.4" "$installDestDir$prefix/$relativeManDir/man4/"
			packageEntries data "$relativeDataDir"
		else
			packageEntries data \
				$dataDir
		fi
		maybe_manDir_man3=$manDir/man3
		rmdir $manDir/man5
		sed -i -e "s,$dataDir/,/system/$relativeDataDir/,g" \
			$manDir/man1/file.1 \
			$manDir/man3/libmagic.3 \
			$manDir/man4/magic.4
	else
		maybe_manDir_man3=
		rm -rf $dataDir $manDir
	fi

	if [ "$targetArchitecture" = arm64 ]; then
		maybe_manDir_man3=${maybe_manDir_man3#"$prefix"/}
		packageEntries devel "$relativeDevelopDir" "$maybe_manDir_man3"
	else
		packageEntries devel \
			$developDir \
			$maybe_manDir_man3
	fi
}

TEST()
{
	make check
}
