SUMMARY="A console-based calculator utility"
DESCRIPTION="bc is an arbitrary precision numeric processing language. Syntax \
is similar to C, but differs in many substantial areas. It supports \
interactive execution of statements. bc is a utility included in the POSIX \
P1003.2/D11 draft standard."
HOMEPAGE="http://www.gnu.org/software/bc/bc.html"
COPYRIGHT="1991-2000 Free Software Foundation, Inc."
LICENSE="GNU GPL v2
	GNU LGPL v2.1"
REVISION="2"
SOURCE_URI="http://ftp.gnu.org/gnu/bc/bc-$portVersion.tar.gz"
CHECKSUM_SHA256="62adfca89b0a1c0164c2cdca59ca210c1d44c3ffc46daf9931cf4942664cb02a"
PATCHES="bc-$portVersion.patchset"

ARCHITECTURES="all"

PROVIDES="
	bc = $portVersion
	cmd:bc
	cmd:dc
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	cmd:bison
	cmd:ed
	cmd:flex
	cmd:gawk
	cmd:gcc
	cmd:make
	cmd:makeinfo
	cmd:perl
	"

BUILD()
{
	runConfigure --omit-dirs "docDir dataRootDir" ./configure
	if [ "$targetArchitecture" = arm64 ]; then
		# Generate the math bytecode with the existing host interpreter.
		cat > bc/fix-libmath_h <<'EOF'
#!/bin/sh
sed -i '1s/^/{"/;s/$/",/;2,$s/^/"/' libmath.h
sed -i '$d' libmath.h
sed -i '$s/,$/,0}/' libmath.h
EOF
		chmod +x bc/fix-libmath_h
		sed -i "s|\./fbc -c|/usr/bin/bc -c|" bc/Makefile
	fi
	make -j1
}

INSTALL()
{
	if [ "$targetArchitecture" = arm64 ]; then
		make install DESTDIR="$installDestDir"
	else
		make install
	fi
}

TEST()
{
	make check
	cd Test
	./timetest
}
